
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Dashboard - InventoryPro</title>

    <link rel="stylesheet" href="/css/style.css">

    <style>
        .dashboard-page {
            max-width: 1400px;
            margin: 0 auto;
            padding: 30px;
        }

        .dashboard-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 30px;
        }

        .dashboard-header h1 {
            margin: 0 0 8px;
            color: #0f172a;
            font-size: 30px;
        }

        .dashboard-header p {
            margin: 0;
            color: #64748b;
        }

        .dashboard-header-actions {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .dashboard-btn {
            display: inline-block;
            padding: 11px 18px;
            border-radius: 8px;
            background: #2563eb;
            color: white;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            border: none;
            cursor: pointer;
        }

        .dashboard-btn:hover {
            background: #1d4ed8;
        }

        .dashboard-btn.logout {
            background: white;
            border: 1px solid #cbd5e1;
            color: #334155;
        }

        .dashboard-btn.logout:hover {
            background: #f1f5f9;
        }

        .dashboard-welcome {
            padding: 26px;
            margin-bottom: 28px;
            border-radius: 14px;
            background: linear-gradient(120deg, #1d4ed8, #4338ca);
            color: white;
        }

        .dashboard-welcome h2 {
            margin: 0 0 8px;
            font-size: 24px;
        }

        .dashboard-welcome p {
            margin: 0;
            color: #e0e7ff;
            line-height: 1.6;
        }

        .dashboard-section-title {
            margin: 0 0 18px;
            color: #0f172a;
            font-size: 21px;
        }

        /* Statistics Cards */
        .dashboard-stats {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 18px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 22px;
            box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
        }

        .stat-card h3 {
            margin: 0 0 12px;
            color: #64748b;
            font-size: 14px;
            font-weight: 600;
        }

        .stat-card .stat-value {
            margin: 0;
            color: #0f172a;
            font-size: 26px;
            font-weight: 700;
            overflow-wrap: anywhere;
        }

        .stat-card .stat-description {
            margin: 8px 0 0;
            color: #94a3b8;
            font-size: 12px;
        }

        .stat-card.low {
            border-left: 4px solid #f59e0b;
        }

        .stat-card.out {
            border-left: 4px solid #ef4444;
        }

        .stat-card.value {
            border-left: 4px solid #16a34a;
        }

        /* General Sections */
        .dashboard-panel {
            padding: 24px;
            margin-bottom: 28px;
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
        }

        .panel-header {
            margin-bottom: 20px;
        }

        .panel-header h2 {
            margin: 0 0 6px;
            color: #0f172a;
            font-size: 22px;
        }

        .panel-header p {
            margin: 0;
            color: #64748b;
            font-size: 14px;
        }

        /* Tables */
        .table-wrapper {
            width: 100%;
            overflow-x: auto;
        }

        .dashboard-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        .dashboard-table th,
        .dashboard-table td {
            padding: 14px 16px;
            border-bottom: 1px solid #e2e8f0;
            white-space: nowrap;
        }

        .dashboard-table th {
            background: #f8fafc;
            color: #475569;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .dashboard-table td {
            color: #334155;
            font-size: 14px;
        }

        .dashboard-table tbody tr:hover {
            background: #f8fafc;
        }

        .stock-status {
            display: inline-block;
            padding: 6px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
        }

        .stock-status.low {
            background: #fef3c7;
            color: #92400e;
        }

        .stock-status.out {
            background: #fee2e2;
            color: #991b1b;
        }

        .stock-status.in {
            background: #dcfce7;
            color: #166534;
        }

        .stock-status.movement-out {
            background: #fee2e2;
            color: #991b1b;
        }

        .empty-state {
            padding: 24px;
            text-align: center;
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            border-radius: 10px;
            color: #166534;
        }

        .empty-state h3 {
            margin: 0 0 8px;
        }

        .empty-state p {
            margin: 0;
            font-size: 14px;
        }

        /* Quick Links */
        .dashboard-quick-links {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 18px;
        }

        .quick-link-card {
            display: block;
            padding: 22px;
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            text-decoration: none;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .quick-link-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(15, 23, 42, 0.08);
        }

        .quick-link-card h3 {
            margin: 0 0 8px;
            color: #1e293b;
            font-size: 17px;
        }

        .quick-link-card p {
            margin: 0;
            color: #64748b;
            font-size: 14px;
            line-height: 1.6;
        }

        @media (max-width: 1100px) {
            .dashboard-stats {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }
        }

        @media (max-width: 768px) {
            .dashboard-page {
                padding: 18px;
            }

            .dashboard-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .dashboard-stats {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .dashboard-quick-links {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 480px) {
            .dashboard-stats {
                grid-template-columns: 1fr;
            }

            .dashboard-welcome {
                padding: 20px;
            }

            .dashboard-header h1 {
                font-size: 25px;
            }

            .dashboard-panel {
                padding: 16px;
            }

            .stat-card .stat-value {
                font-size: 23px;
            }
        }
    </style>
</head>

<body>

    <main class="dashboard-page">

        <!-- Dashboard Header -->
        <header class="dashboard-header">

            <div>
                <h1>Inventory Dashboard</h1>
                <p>Monitor your inventory and stock levels.</p>
            </div>

            <div class="dashboard-header-actions">

                <a href="/products" class="dashboard-btn">
                    View Products
                </a>

                <form action="/logout" method="POST" style="display: inline;">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <button type="submit" class="dashboard-btn logout">
                        Logout
                    </button>
                </form>

            </div>

        </header>

        <!-- Welcome Section -->
        <section class="dashboard-welcome">

            <h2>Welcome, <%= user.name %>!</h2>

            <p>
                You are logged in as
                <strong><%= user.role %></strong>.
                Here is your current inventory overview.
            </p>

        </section>

        <!-- Dashboard Statistics -->
        <section>

            <h2 class="dashboard-section-title">
                Inventory Overview
            </h2>

            <div class="dashboard-stats">

                <div class="stat-card">
                    <h3>Total Products</h3>

                    <p class="stat-value">
                        <%= totalProducts || 0 %>
                    </p>

                    <p class="stat-description">
                        Products in your inventory
                    </p>
                </div>

                <div class="stat-card">
                    <h3>Total Stock Units</h3>

                    <p class="stat-value">
                        <%= totalUnits || 0 %>
                    </p>

                    <p class="stat-description">
                        Total available quantity
                    </p>
                </div>

                <div class="stat-card low">
                    <h3>Low Stock Items</h3>

                    <p class="stat-value">
                        <%= lowStockCount || 0 %>
                    </p>

                    <p class="stat-description">
                        Products needing attention
                    </p>
                </div>

                <div class="stat-card out">
                    <h3>Out of Stock</h3>

                    <p class="stat-value">
                        <%= outOfStockCount || 0 %>
                    </p>

                    <p class="stat-description">
                        Products with zero quantity
                    </p>
                </div>

                <div class="stat-card value">
                    <h3>Inventory Value</h3>

                    <p class="stat-value">
                        <%= Number(inventoryValue || 0).toLocaleString("en-IN", {
                            style: "currency",
                            currency: "INR",
                            maximumFractionDigits: 2
                        }) %>
                    </p>

                    <p class="stat-description">
                        Total value of available stock
                    </p>
                </div>

            </div>

        </section>

        <!-- Stock Alerts -->
        <section class="dashboard-panel">

            <div class="panel-header">

                <h2>Stock Alerts</h2>

                <p>Products that need your attention.</p>

            </div>

            <% if (lowStockProducts && lowStockProducts.length > 0) { %>

                <div class="table-wrapper">

                    <table class="dashboard-table">

                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>SKU</th>
                                <th>Category</th>
                                <th>Available Quantity</th>
                                <th>Threshold</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% lowStockProducts.forEach(product => { %>

                                <tr>

                                    <td>
                                        <%= product.name %>
                                    </td>

                                    <td>
                                        <%= product.sku || "-" %>
                                    </td>

                                    <td>
                                        <%= product.category
                                            ? product.category.name
                                            : "-" %>
                                    </td>

                                    <td>
                                        <%= product.quantity %>
                                    </td>

                                    <td>
                                        <%= product.lowStockThreshold ?? 5 %>
                                    </td>

                                    <td>

                                        <% if (product.quantity === 0) { %>

                                            <span class="stock-status out">
                                                Out of Stock
                                            </span>

                                        <% } else { %>

                                            <span class="stock-status low">
                                                Low Stock
                                            </span>

                                        <% } %>

                                    </td>

                                </tr>

                            <% }); %>

                        </tbody>

                    </table>

                </div>

            <% } else { %>

                <div class="empty-state">

                    <h3>All products have sufficient stock</h3>

                    <p>
                        There are currently no products that meet
                        the low-stock alert condition.
                    </p>

                </div>

            <% } %>

        </section>

        <!-- Recent Stock Movements -->
        <section class="dashboard-panel">

            <div class="panel-header">

                <h2>Recent Stock Movements</h2>

                <p>Latest stock-in and stock-out transactions.</p>

            </div>

            <% if (recentMovements && recentMovements.length > 0) { %>

                <div class="table-wrapper">

                    <table class="dashboard-table">

                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Type</th>
                                <th>Quantity</th>
                                <th>Previous Stock</th>
                                <th>New Stock</th>
                                <th>Performed By</th>
                                <th>Date</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% recentMovements.forEach(movement => { %>

                                <tr>

                                    <td>
                                        <%= movement.product
                                            ? movement.product.name
                                            : "Deleted Product" %>
                                    </td>

                                    <td>

                                        <% if (movement.type === "Stock In") { %>

                                            <span class="stock-status in">
                                                Stock In
                                            </span>

                                        <% } else { %>

                                            <span class="stock-status movement-out">
                                                Stock Out
                                            </span>

                                        <% } %>

                                    </td>

                                    <td>
                                        <%= movement.quantity %>
                                    </td>

                                    <td>
                                        <%= movement.previousQuantity %>
                                    </td>

                                    <td>
                                        <%= movement.newQuantity %>
                                    </td>

                                    <td>
                                        <%= movement.performedBy
                                            ? movement.performedBy.name
                                            : "Unknown" %>
                                    </td>

                                    <td>
                                        <%= movement.createdAt
                                            ? new Date(movement.createdAt).toLocaleString("en-IN")
                                            : "-" %>
                                    </td>

                                </tr>

                            <% }); %>

                        </tbody>

                    </table>

                </div>

            <% } else { %>

                <div class="empty-state">

                    <h3>No Recent Stock Movements</h3>

                    <p>
                        Stock transactions will appear here when
                        you add or remove stock.
                    </p>

                </div>

            <% } %>

        </section>

        <!-- Quick Access -->
        <section>

            <h2 class="dashboard-section-title">
                Quick Access
            </h2>

            <div class="dashboard-quick-links">

                <a href="/products" class="quick-link-card">
                    <h3>Products</h3>
                    <p>View and manage your inventory products.</p>
                </a>

                <a href="/categories" class="quick-link-card">
                    <h3>Categories</h3>
                    <p>Organize products by category.</p>
                </a>

                <a href="/suppliers" class="quick-link-card">
                    <h3>Suppliers</h3>
                    <p>View and manage supplier information.</p>
                </a>

                <a href="/stock" class="quick-link-card">
                    <h3>Stock History</h3>
                    <p>Review stock-in and stock-out transactions.</p>
                </a>

                <% if (["Admin", "Manager"].includes(user.role)) { %>

                    <a href="/stock/adjust" class="quick-link-card">
                        <h3>Adjust Stock</h3>
                        <p>Record incoming or outgoing stock.</p>
                    </a>

                    <a href="/products/add" class="quick-link-card">
                        <h3>Add Product</h3>
                        <p>Add a new product to your inventory.</p>
                    </a>

                <% } %>

                <a href="/sales" class="quick-link-card">
                    <h3>Sales</h3>
                    <p>View sales records and manage sales transactions.</p>
                </a>

                <a href="/reports" class="quick-link-card">
                    <h3>Reports & Analytics</h3>
                    <p>View sales, purchases, and inventory reports.</p>
                </a>

            </div>

        </section>

    </main>

</body>

</html>
