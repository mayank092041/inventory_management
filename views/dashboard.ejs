
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Dashboard - InventoryPro</title>

    <link rel="stylesheet" href="/css/style.css">

    <style>
        .dashboard-page {
            max-width: 1400px;
            margin: 0 auto;
            padding: 30px;
        }

        .dashboard-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 30px;
        }

        .dashboard-header h1 {
            margin: 0 0 8px;
            color: #0f172a;
            font-size: 30px;
        }

        .dashboard-header p {
            margin: 0;
            color: #64748b;
        }

        .dashboard-header-actions {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .dashboard-btn {
            display: inline-block;
            padding: 11px 18px;
            border-radius: 8px;
            background: #2563eb;
            color: #ffffff;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
        }

        .dashboard-btn:hover {
            background: #1d4ed8;
        }

        .dashboard-btn.logout {
            background: #ffffff;
            border: 1px solid #cbd5e1;
            color: #334155;
        }

        .dashboard-btn.logout:hover {
            background: #f1f5f9;
        }

        .dashboard-welcome {
            padding: 26px;
            margin-bottom: 28px;
            border-radius: 14px;
            background: linear-gradient(120deg, #1d4ed8, #4338ca);
            color: #ffffff;
        }

        .dashboard-welcome h2 {
            margin: 0 0 8px;
            font-size: 24px;
        }

        .dashboard-welcome p {
            margin: 0;
            color: #e0e7ff;
            line-height: 1.6;
        }

        .dashboard-section-title {
            margin: 0 0 18px;
            color: #0f172a;
            font-size: 21px;
        }

        .stock-alert-section {
            padding: 24px;
            margin-bottom: 28px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
        }

        .stock-alert-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            margin-bottom: 22px;
        }

        .stock-alert-header h2 {
            margin: 0 0 6px;
            color: #0f172a;
            font-size: 22px;
        }

        .stock-alert-header p {
            margin: 0;
            color: #64748b;
            font-size: 14px;
        }

        .stock-alert-cards {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px;
            margin-bottom: 24px;
        }

        .stock-alert-card {
            padding: 22px;
            border-radius: 12px;
            border: 1px solid transparent;
        }

        .stock-alert-card.low {
            background: #fffbeb;
            border-color: #fde68a;
            color: #92400e;
        }

        .stock-alert-card.out {
            background: #fef2f2;
            border-color: #fecaca;
            color: #991b1b;
        }

        .stock-alert-card .alert-label {
            display: block;
            margin-bottom: 10px;
            font-size: 14px;
            font-weight: 600;
        }

        .stock-alert-card .alert-count {
            margin: 0;
            font-size: 32px;
            font-weight: 700;
        }

        .stock-alert-card .alert-description {
            margin: 8px 0 0;
            font-size: 13px;
        }

        .stock-alert-table-wrapper {
            width: 100%;
            overflow-x: auto;
        }

        .stock-alert-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        .stock-alert-table th,
        .stock-alert-table td {
            padding: 14px 16px;
            border-bottom: 1px solid #e2e8f0;
            white-space: nowrap;
        }

        .stock-alert-table th {
            background: #f8fafc;
            color: #475569;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .stock-alert-table td {
            color: #334155;
            font-size: 14px;
        }

        .stock-alert-table tbody tr:hover {
            background: #f8fafc;
        }

        .stock-status {
            display: inline-block;
            padding: 6px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
        }

        .stock-status.low {
            background: #fef3c7;
            color: #92400e;
        }

        .stock-status.out {
            background: #fee2e2;
            color: #991b1b;
        }

        .stock-empty-state {
            padding: 24px;
            text-align: center;
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            border-radius: 10px;
            color: #166534;
        }

        .stock-empty-state h3 {
            margin: 0 0 8px;
        }

        .stock-empty-state p {
            margin: 0;
            font-size: 14px;
        }

        .dashboard-quick-links {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 18px;
        }

        .quick-link-card {
            display: block;
            padding: 22px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            text-decoration: none;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .quick-link-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(15, 23, 42, 0.08);
        }

        .quick-link-card h3 {
            margin: 0 0 8px;
            color: #1e293b;
            font-size: 17px;
        }

        .quick-link-card p {
            margin: 0;
            color: #64748b;
            font-size: 14px;
            line-height: 1.6;
        }

        @media (max-width: 768px) {
            .dashboard-page {
                padding: 18px;
            }

            .dashboard-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .stock-alert-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .dashboard-quick-links {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 480px) {
            .stock-alert-cards {
                grid-template-columns: 1fr;
            }

            .dashboard-welcome {
                padding: 20px;
            }

            .dashboard-header h1 {
                font-size: 25px;
            }

            .stock-alert-section {
                padding: 16px;
            }
        }
    </style>
</head>

<body>
    <main class="dashboard-page">

        <!-- Dashboard Header -->
        <header class="dashboard-header">
            <div>
                <h1>Inventory Dashboard</h1>
                <p>Monitor your inventory and stock levels.</p>
            </div>

            <div class="dashboard-header-actions">
                <a href="/products" class="dashboard-btn">
                    View Products
                </a>

                <a href="/logout" class="dashboard-btn logout">
                    Logout
                </a>
            </div>
        </header>

        <!-- Welcome Section -->
        <section class="dashboard-welcome">
            <h2>
                Welcome, <%= user.name %>!
            </h2>

            <p>
                You are logged in as <strong><%= user.role %></strong>.
                Here is your current inventory overview.
            </p>
        </section>

        <!-- Stock Alerts -->
        <section class="stock-alert-section">

            <div class="stock-alert-header">
                <div>
                    <h2>Stock Alerts</h2>
                    <p>Products that need your attention.</p>
                </div>

                <a href="/products" class="dashboard-btn">
                    View Products
                </a>
            </div>

            <div class="stock-alert-cards">
                <div class="stock-alert-card low">
                    <span class="alert-label">Low Stock</span>

                    <p class="alert-count">
                        <%= lowStockCount %>
                    </p>

                    <p class="alert-description">
                        Products below their stock threshold.
                    </p>
                </div>

                <div class="stock-alert-card out">
                    <span class="alert-label">Out of Stock</span>

                    <p class="alert-count">
                        <%= outOfStockCount %>
                    </p>

                    <p class="alert-description">
                        Products with zero available quantity.
                    </p>
                </div>
            </div>

            <% if (lowStockProducts.length > 0) { %>

                <h3 class="dashboard-section-title">
                    Products Requiring Attention
                </h3>

                <div class="stock-alert-table-wrapper">
                    <table class="stock-alert-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>SKU</th>
                                <th>Available Quantity</th>
                                <th>Threshold</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% lowStockProducts.forEach(product => { %>
                                <tr>
                                    <td><%= product.name %></td>
                                    <td><%= product.sku %></td>
                                    <td><%= product.quantity %></td>
                                    <td>
                                        <%= product.lowStockThreshold ?? 5 %>
                                    </td>
                                    <td>
                                        <% if (product.quantity === 0) { %>
                                            <span class="stock-status out">
                                                Out of Stock
                                            </span>
                                        <% } else { %>
                                            <span class="stock-status low">
                                                Low Stock
                                            </span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>

            <% } else { %>

                <div class="stock-empty-state">
                    <h3>All products have sufficient stock</h3>
                    <p>
                        There are currently no products that meet the
                        low-stock alert condition.
                    </p>
                </div>

            <% } %>

        </section>

        <!-- Quick Links -->
        <section>
            <h2 class="dashboard-section-title">Quick Access</h2>

            <div class="dashboard-quick-links">

                <a href="/products" class="quick-link-card">
                    <h3>Products</h3>
                    <p>View and manage your inventory products.</p>
                </a>

                <a href="/categories" class="quick-link-card">
                    <h3>Categories</h3>
                    <p>Organize products by category.</p>
                </a>

                <a href="/suppliers" class="quick-link-card">
                    <h3>Suppliers</h3>
                    <p>View and manage supplier information.</p>
                </a>

                <a href="/stock" class="quick-link-card">
                    <h3>Stock History</h3>
                    <p>Review stock-in and stock-out transactions.</p>
                </a>

                <% if (["Admin", "Manager"].includes(user.role)) { %>
                    <a href="/stock/adjust" class="quick-link-card">
                        <h3>Adjust Stock</h3>
                        <p>Record incoming or outgoing stock.</p>
                    </a>

                    <a href="/products/add" class="quick-link-card">
                        <h3>Add Product</h3>
                        <p>Add a new product to your inventory.</p>
                    </a>
                <% } %>

            </div>
        </section>

    </main>
</body>
</html>
