<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Sale | InventoryPro</title>
    <link rel="stylesheet" href="/css/style.css">

    <style>
        .sales-container {
            max-width: 1100px;
            margin: 30px auto;
            padding: 24px;
        }

        .sales-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            margin-bottom: 24px;
            flex-wrap: wrap;
        }

        .sales-header h1 {
            margin: 0 0 6px;
        }

        .sales-muted {
            color: #64748b;
            font-size: 14px;
        }

        .sales-card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            padding: 24px;
            margin-bottom: 20px;
            box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
        }

        .sales-card h2 {
            margin-top: 0;
            font-size: 18px;
        }

        .sales-field {
            display: flex;
            flex-direction: column;
            gap: 7px;
        }

        .sales-field label {
            font-size: 14px;
            font-weight: 600;
            color: #334155;
        }

        .sales-field select,
        .sales-field input {
            width: 100%;
            box-sizing: border-box;
            padding: 11px 12px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            font: inherit;
            background: #fff;
            color: #0f172a;
        }

        .sales-field input:focus,
        .sales-field select:focus {
            outline: 2px solid #bfdbfe;
            border-color: #2563eb;
        }

        .sales-items {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .sales-item {
            display: grid;
            grid-template-columns: minmax(190px, 2fr) minmax(100px, .8fr) minmax(130px, 1fr) auto;
            gap: 14px;
            align-items: end;
            padding: 16px;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            background: #f8fafc;
        }

        .sales-item-total {
            font-weight: 700;
            color: #0f766e;
            margin-top: 8px;
            font-size: 14px;
        }

        .sales-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            padding: 11px 16px;
            border: 0;
            border-radius: 8px;
            cursor: pointer;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
        }

        .sales-primary {
            background: #2563eb;
            color: #fff;
        }

        .sales-secondary {
            background: #e2e8f0;
            color: #1e293b;
        }

        .sales-danger {
            background: #fee2e2;
            color: #b91c1c;
        }

        .sales-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: 20px;
        }

        .sales-summary {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            background: #eff6ff;
            padding: 20px;
            border-radius: 10px;
        }

        .sales-grand-total {
            color: #1d4ed8;
            font-size: 28px;
            font-weight: 800;
        }

        .sales-error {
            display: none;
            padding: 12px 14px;
            border-radius: 8px;
            background: #fef2f2;
            color: #b91c1c;
            margin-bottom: 16px;
        }

        @media (max-width: 720px) {
            .sales-container {
                padding: 14px;
                margin: 12px auto;
            }

            .sales-card {
                padding: 16px;
            }

            .sales-item {
                grid-template-columns: 1fr 1fr;
            }

            .sales-item .sales-product-field {
                grid-column: 1 / -1;
            }

            .sales-summary {
                align-items: flex-start;
                flex-direction: column;
            }
        }
    </style>
</head>

<body>
    <main class="sales-container">
        <header class="sales-header">
            <div>
                <h1>Record a Sale</h1>
                <p class="sales-muted">Create a sale and update your inventory.</p>
            </div>
            <a href="/sales" class="sales-button sales-secondary">← Sales History</a>
        </header>

        <form action="/sales/add" method="POST" id="saleForm">
            <section class="sales-card">
                <h2>Sale Items</h2>
                <p class="sales-muted">Select a product, enter the quantity and selling price per unit.</p>

                <div id="formError" class="sales-error" role="alert"></div>

                <% if (!products || products.length===0) { %>
                    <p>No products are available. Add products before recording a sale.</p>
                    <% } else { %>
                        <div id="saleItems" class="sales-items">
                            <div class="sales-item">
                                <div class="sales-field sales-product-field">
                                    <label>Product</label>
                                    <select name="product" class="product-select" required>
                                        <option value="">Select a product</option>
                                        <% products.forEach(product=> { %>
                                            <option value="<%= product._id %>" data-stock="<%= product.quantity || 0 %>"
                                                data-price="<%= product.sellingPrice ?? product.salePrice ?? product.price ?? '' %>"
                                                <%=product.quantity < 1 ? 'disabled' : '' %>
                                                >
                                                <%= product.name || product.productName || product.title
                                                    || 'Unnamed Product' %>
                                                    — Stock: <%= product.quantity ?? 0 %>
                                            </option>
                                            <% }) %>
                                    </select>
                                    <div class="sales-muted stock-info">Available stock: —</div>
                                </div>

                                <div class="sales-field">
                                    <label>Quantity</label>
                                    <input type="number" name="quantity" class="quantity-input" min="1" step="1"
                                        value="1" required>
                                </div>

                                <div class="sales-field">
                                    <label>Selling Price (₹ / unit)</label>
                                    <input type="number" name="sellingPrice" class="price-input" min="0.01" step="0.01"
                                        placeholder="Enter price" required>
                                    <div class="sales-item-total">Subtotal: ₹0.00</div>
                                </div>

                                <button type="button" class="sales-button sales-danger remove-item"
                                    aria-label="Remove product" disabled>Remove</button>
                            </div>
                        </div>

                        <div class="sales-actions">
                            <button type="button" id="addItem" class="sales-button sales-secondary">+ Add Another
                                Product</button>
                        </div>
                        <% } %>
            </section>

            <section class="sales-card">
                <div class="sales-summary">
                    <div>
                        <strong>Total Sale Amount</strong>
                        <div class="sales-muted">Calculated from all sale items</div>
                    </div>
                    <div id="grandTotal" class="sales-grand-total">₹0.00</div>
                </div>

                <div class="sales-actions">
                    <button type="submit" class="sales-button sales-primary" <%=!products || products.length===0
                        ? 'disabled' : '' %>>
                        Complete Sale
                    </button>
                    <a href="/sales" class="sales-button sales-secondary">Cancel</a>
                </div>
            </section>
        </form>
    </main>

    <script>
        const saleItems = document.getElementById("saleItems");
        const addItemButton = document.getElementById("addItem");
        const saleForm = document.getElementById("saleForm");
        const grandTotalElement = document.getElementById("grandTotal");
        const formError = document.getElementById("formError");

        function money(value) {
            return Number(value).toLocaleString("en-IN", {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        }

        function showError(message) {
            formError.textContent = message;
            formError.style.display = "block";
        }

        function clearError() {
            formError.textContent = "";
            formError.style.display = "none";
        }

        function updateProductOptions() {
            if (!saleItems) return;

            const rows = [...saleItems.querySelectorAll(".sales-item")];
            const selectedIds = rows
                .map(row => row.querySelector(".product-select").value)
                .filter(Boolean);

            rows.forEach(row => {
                const select = row.querySelector(".product-select");

                [...select.options].forEach(option => {
                    if (!option.value) return;

                    option.disabled =
                        Number(option.dataset.stock) < 1 ||
                        (selectedIds.includes(option.value) && option.value !== select.value);
                });

                const selectedOption = select.selectedOptions[0];
                const stockInfo = row.querySelector(".stock-info");
                const quantityInput = row.querySelector(".quantity-input");

                if (selectedOption && selectedOption.value) {
                    const stock = Number(selectedOption.dataset.stock);
                    stockInfo.textContent = "Available stock: " + stock;
                    quantityInput.max = stock;

                    if (Number(quantityInput.value) > stock) {
                        quantityInput.setCustomValidity("Quantity cannot exceed available stock.");
                    } else {
                        quantityInput.setCustomValidity("");
                    }
                } else {
                    stockInfo.textContent = "Available stock: —";
                    quantityInput.removeAttribute("max");
                    quantityInput.setCustomValidity("");
                }
            });
        }

        function calculateTotal() {
            if (!saleItems) return;

            let grandTotal = 0;

            saleItems.querySelectorAll(".sales-item").forEach(row => {
                const quantity = Number(row.querySelector(".quantity-input").value);
                const price = Number(row.querySelector(".price-input").value);
                const subtotal = quantity > 0 && price > 0 ? quantity * price : 0;

                row.querySelector(".sales-item-total").textContent =
                    "Subtotal: ₹" + money(subtotal);

                grandTotal += subtotal;
            });

            grandTotalElement.textContent = "₹" + money(grandTotal);
        }

        function attachRowEvents(row) {
            const select = row.querySelector(".product-select");
            const priceInput = row.querySelector(".price-input");
            const quantityInput = row.querySelector(".quantity-input");
            const removeButton = row.querySelector(".remove-item");

            select.addEventListener("change", () => {
                clearError();

                const option = select.selectedOptions[0];
                priceInput.value = option && option.dataset.price
                    ? option.dataset.price
                    : "";

                updateProductOptions();
                calculateTotal();
            });

            quantityInput.addEventListener("input", () => {
                clearError();
                updateProductOptions();
                calculateTotal();
            });

            priceInput.addEventListener("input", () => {
                clearError();
                calculateTotal();
            });

            removeButton.addEventListener("click", () => {
                row.remove();
                updateRemoveButtons();
                updateProductOptions();
                calculateTotal();
            });
        }

        function updateRemoveButtons() {
            const rows = saleItems.querySelectorAll(".sales-item");

            rows.forEach(row => {
                row.querySelector(".remove-item").disabled = rows.length === 1;
            });
        }

        if (saleItems) {
            const firstRow = saleItems.querySelector(".sales-item");
            attachRowEvents(firstRow);

            addItemButton.addEventListener("click", () => {
                clearError();

                const newRow = firstRow.cloneNode(true);
                newRow.querySelector(".product-select").value = "";
                newRow.querySelector(".quantity-input").value = "1";
                newRow.querySelector(".quantity-input").removeAttribute("max");
                newRow.querySelector(".quantity-input").setCustomValidity("");
                newRow.querySelector(".price-input").value = "";
                newRow.querySelector(".stock-info").textContent = "Available stock: —";
                newRow.querySelector(".sales-item-total").textContent = "Subtotal: ₹0.00";

                saleItems.appendChild(newRow);
                attachRowEvents(newRow);
                updateRemoveButtons();
                updateProductOptions();
                calculateTotal();
            });

            saleForm.addEventListener("submit", event => {
                clearError();

                const rows = [...saleItems.querySelectorAll(".sales-item")];
                const selectedIds = rows.map(row => row.querySelector(".product-select").value);

                if (selectedIds.some(id => !id)) {
                    event.preventDefault();
                    showError("Please select a product for every row.");
                    return;
                }

                if (new Set(selectedIds).size !== selectedIds.length) {
                    event.preventDefault();
                    showError("Each product can only be selected once. Change or remove the duplicate row.");
                    return;
                }

                for (const row of rows) {
                    const select = row.querySelector(".product-select");
                    const quantity = Number(row.querySelector(".quantity-input").value);
                    const price = Number(row.querySelector(".price-input").value);
                    const stock = Number(select.selectedOptions[0].dataset.stock);

                    if (!Number.isSafeInteger(quantity) || quantity < 1 || quantity > stock) {
                        event.preventDefault();
                        showError("Enter a valid quantity that does not exceed available stock.");
                        return;
                    }

                    if (!Number.isFinite(price) || price <= 0) {
                        event.preventDefault();
                        showError("Enter a selling price greater than zero for every product.");
                        return;
                    }
                }
            });

            updateRemoveButtons();
            updateProductOptions();
            calculateTotal();
        }
    </script>
</body>

</html>