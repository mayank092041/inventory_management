<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>InventoryPro - Inventory Management System</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <!-- Navbar -->

    <header class="navbar">

        <div class="logo">
            Inventory<span>Pro</span>
        </div>

        <nav>
            <a href="#features">Features</a>
            <a href="#about">About</a>
            <a href="/login" class="login-btn">Login</a>
            <a href="/register" class="register-btn">Register</a>
        </nav>

    </header>


    <!-- Hero Section -->

    <section class="hero">

        <div class="hero-content">

            <p class="tagline">
                SMART INVENTORY MANAGEMENT
            </p>

            <h1>
                Manage Your Inventory.
                <span>Smarter.</span>
            </h1>

            <p class="hero-text">
                Manage products, track stock, monitor sales,
                handle purchases and get complete insights
                from one simple platform.
            </p>

            <div class="hero-buttons">

                <a href="/login" class="primary-btn">
                    Get Started
                </a>

                <a href="#features" class="secondary-btn">
                    Explore Features
                </a>

            </div>

        </div>


        <div class="hero-card">

            <div class="card-header">
                <span>Inventory Overview</span>
                <span class="status">● Live</span>
            </div>

            <div class="stats">

                <div class="stat-box">
                    <p>Total Products</p>
                    <h2>1,250</h2>
                </div>

                <div class="stat-box">
                    <p>Total Stock</p>
                    <h2>8,420</h2>
                </div>

                <div class="stat-box">
                    <p>Low Stock</p>
                    <h2>32</h2>
                </div>

                <div class="stat-box">
                    <p>Today's Sales</p>
                    <h2>₹25.4K</h2>
                </div>

            </div>

        </div>

    </section>


    <!-- Features -->

    <section id="features" class="features-section">

        <div class="section-heading">

            <p>FEATURES</p>

            <h2>
                Everything you need to manage inventory
            </h2>

            <span>
                Simple tools to help you control your inventory
                efficiently.
            </span>

        </div>


        <div class="features-grid">

            <div class="feature-card">

                <div class="icon">
                    📦
                </div>

                <h3>
                    Product Management
                </h3>

                <p>
                    Add, update, search and manage all your
                    products from one place.
                </p>

            </div>


            <div class="feature-card">

                <div class="icon">
                    📊
                </div>

                <h3>
                    Real-Time Dashboard
                </h3>

                <p>
                    Monitor your stock, sales and inventory
                    information through a simple dashboard.
                </p>

            </div>


            <div class="feature-card">

                <div class="icon">
                    🚨
                </div>

                <h3>
                    Stock Alerts
                </h3>

                <p>
                    Identify low-stock and out-of-stock
                    products quickly.
                </p>

            </div>


            <div class="feature-card">

                <div class="icon">
                    📈
                </div>

                <h3>
                    Reports & Insights
                </h3>

                <p>
                    Analyze sales, purchases and inventory
                    performance.
                </p>

            </div>

        </div>

    </section>


    <!-- About -->

    <section id="about" class="about-section">

        <div>

            <p class="section-label">
                HOW IT WORKS
            </p>

            <h2>
                Manage your inventory in four simple steps.
            </h2>

        </div>


        <div class="steps">

            <div class="step">

                <span>01</span>

                <div>
                    <h3>Add Products</h3>
                    <p>
                        Add products and organize them
                        into categories.
                    </p>
                </div>

            </div>


            <div class="step">

                <span>02</span>

                <div>
                    <h3>Manage Stock</h3>
                    <p>
                        Track stock coming in and going out.
                    </p>
                </div>

            </div>


            <div class="step">

                <span>03</span>

                <div>
                    <h3>Track Sales</h3>
                    <p>
                        Record sales and automatically
                        update inventory.
                    </p>
                </div>

            </div>


            <div class="step">

                <span>04</span>

                <div>
                    <h3>Analyze</h3>
                    <p>
                        View reports and understand
                        your inventory performance.
                    </p>
                </div>

            </div>

        </div>

    </section>


    <!-- CTA -->

    <section class="cta">

        <h2>
            Ready to take control of your inventory?
        </h2>

        <p>
            Start managing your inventory efficiently.
        </p>

        <a href="/login" class="primary-btn">
            Get Started
        </a>

    </section>


    <!-- Footer -->

    <footer>

        <div class="logo">
            Inventory<span>Pro</span>
        </div>

        <p>
            Inventory management made simple.
        </p>

        <p>
            © 2026 InventoryPro. All rights reserved.
        </p>

    </footer>


    <script src="/js/script.js"></script>

</body>

</html>