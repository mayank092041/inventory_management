<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Reports & Analytics | InventoryPro</title>

  <link rel="stylesheet" href="/css/style.css">

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    .reports-container {
      max-width: 1250px;
      margin: 30px auto;
      padding: 20px;
    }

    .reports-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 15px;
      margin-bottom: 25px;
    }

    .reports-header h1 {
      margin-bottom: 6px;
    }

    .reports-header p {
      color: #64748b;
    }

    .report-button {
      display: inline-block;
      padding: 10px 16px;
      background: #2563eb;
      color: white;
      text-decoration: none;
      border: none;
      border-radius: 7px;
      cursor: pointer;
      font-size: 14px;
    }

    .report-button:hover {
      background: #1d4ed8;
    }

    .filter-form {
      display: flex;
      align-items: end;
      flex-wrap: wrap;
      gap: 12px;
      padding: 18px;
      margin-bottom: 25px;
      background: white;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
    }

    .filter-form label {
      display: block;
      margin-bottom: 6px;
      font-size: 14px;
      font-weight: 600;
    }

    .filter-form input {
      padding: 10px;
      border: 1px solid #cbd5e1;
      border-radius: 7px;
    }

    .quick-filters {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      width: 100%;
      margin-bottom: 5px;
    }

    .quick-filter {
      padding: 8px 13px;
      border: 1px solid #cbd5e1;
      background: #f8fafc;
      color: #334155;
      border-radius: 7px;
      cursor: pointer;
    }

    .quick-filter:hover {
      background: #e2e8f0;
    }

    .report-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
      gap: 18px;
      margin-bottom: 30px;
    }

    .report-card {
      padding: 22px;
      background: white;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      box-shadow: 0 3px 12px rgba(15, 23, 42, 0.04);
    }

    .report-card p {
      margin-bottom: 10px;
      color: #64748b;
      font-size: 14px;
    }

    .report-card h2 {
      margin: 0;
      font-size: 25px;
      color: #0f172a;
      overflow-wrap: anywhere;
    }

    .report-section {
      margin-bottom: 28px;
      padding: 22px;
      background: white;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
    }

    .report-section h2 {
      margin-bottom: 16px;
    }

    .chart-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
      margin-bottom: 28px;
    }

    .chart-card {
      min-width: 0;
      padding: 22px;
      background: white;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
    }

    .chart-card h2 {
      font-size: 19px;
      margin-bottom: 18px;
    }

    .chart-container {
      position: relative;
      height: 320px;
      width: 100%;
    }

    .report-table-wrapper {
      overflow-x: auto;
    }

    .report-table {
      width: 100%;
      border-collapse: collapse;
    }

    .report-table th,
    .report-table td {
      padding: 12px;
      text-align: left;
      border-bottom: 1px solid #e2e8f0;
      white-space: nowrap;
    }

    .report-table th {
      background: #f8fafc;
      color: #334155;
    }

    .stock-warning {
      color: #b45309;
      font-weight: 600;
    }

    .stock-empty {
      color: #dc2626;
      font-weight: 600;
    }

    .empty-message {
      padding: 18px 0;
      color: #64748b;
    }

    .report-exports {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .export-heading {
      margin-bottom: 15px;
    }

    @media (max-width: 750px) {
      .chart-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 600px) {
      .reports-container {
        padding: 12px;
      }

      .filter-form {
        align-items: stretch;
      }

      .filter-form input {
        width: 100%;
        box-sizing: border-box;
      }

      .filter-form>div:not(.quick-filters) {
        width: 100%;
      }

      .report-card h2 {
        font-size: 22px;
      }

      .chart-container {
        height: 260px;
      }
    }
  </style>
</head>

<body>

  <main class="reports-container">

    <!-- Header -->
    <header class="reports-header">
      <div>
        <h1>Reports & Analytics</h1>
        <p>Review sales, purchases, and inventory performance.</p>
      </div>

      <a href="/dashboard" class="report-button">
        Back to Dashboard
      </a>
    </header>

    <!-- Date Filters -->
    <form action="/reports" method="GET" class="filter-form" id="filterForm">

      <div class="quick-filters">
        <button type="button" class="quick-filter" data-days="0">
          Today
        </button>

        <button type="button" class="quick-filter" data-days="7">
          Last 7 Days
        </button>

        <button type="button" class="quick-filter" data-days="30">
          Last 30 Days
        </button>
      </div>

      <div>
        <label for="startDate">Start Date</label>
        <input
          type="date"
          id="startDate"
          name="startDate"
          value="<%= startDate %>"
          required
        >
      </div>

      <div>
        <label for="endDate">End Date</label>
        <input
          type="date"
          id="endDate"
          name="endDate"
          value="<%= endDate %>"
          required
        >
      </div>

      <button type="submit" class="report-button">
        Generate Report
      </button>

    </form>

    <!-- Download Reports -->
    <section class="report-section">

      <h2 class="export-heading">Download Reports</h2>

      <div class="report-exports">

        <a class="report-button export-link"
           data-base="/exports/sales"
           data-format="csv">
          Download Sales CSV
        </a>

        <a class="report-button export-link"
           data-base="/exports/sales"
           data-format="xlsx">
          Download Sales Excel
        </a>

        <a class="report-button export-link"
           data-base="/exports/purchases"
           data-format="csv">
          Download Purchases CSV
        </a>

        <a class="report-button export-link"
           data-base="/exports/purchases"
           data-format="xlsx">
          Download Purchases Excel
        </a>

        <a class="report-button export-link"
           data-base="/exports/inventory"
           data-format="csv">
          Download Inventory CSV
        </a>

        <a class="report-button export-link"
           data-base="/exports/inventory"
           data-format="xlsx">
          Download Inventory Excel
        </a>

      </div>
    </section>

    <!-- Summary Cards -->
    <section class="report-grid">

      <article class="report-card">
        <p>Total Sales Revenue</p>
        <h2>
          ₹<%= Number(totalRevenue || 0).toLocaleString("en-IN", {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
          }) %>
        </h2>
      </article>

      <article class="report-card">
        <p>Purchase Expenditure</p>
        <h2>
          ₹<%= Number(totalPurchaseCost || 0).toLocaleString("en-IN", {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
          }) %>
        </h2>
      </article>

      <article class="report-card">
        <p>Number of Sales</p>
        <h2><%= totalSalesTransactions %></h2>
      </article>

      <article class="report-card">
        <p>Number of Purchases</p>
        <h2><%= totalPurchaseTransactions %></h2>
      </article>

      <article class="report-card">
        <p>Units Sold</p>
        <h2><%= totalUnitsSold %></h2>
      </article>

      <article class="report-card">
        <p>Total Products</p>
        <h2><%= totalProducts %></h2>
      </article>

      <article class="report-card">
        <p>Total Stock Units</p>
        <h2><%= totalStockUnits %></h2>
      </article>

    </section>

    <!-- Charts -->
    <section class="chart-grid">

      <article class="chart-card">
        <h2>Daily Sales Revenue</h2>
        <div class="chart-container">
          <canvas id="salesChart"></canvas>
        </div>
      </article>

      <article class="chart-card">
        <h2>Daily Purchase Expenditure</h2>
        <div class="chart-container">
          <canvas id="purchaseChart"></canvas>
        </div>
      </article>

      <article class="chart-card">
        <h2>Sales vs Purchase Comparison</h2>
        <div class="chart-container">
          <canvas id="comparisonChart"></canvas>
        </div>
      </article>

    </section>

    <!-- Inventory Status -->
    <section class="report-section">

      <h2>Inventory Status</h2>

      <div class="report-table-wrapper">
        <table class="report-table">

          <thead>
            <tr>
              <th>Product</th>
              <th>SKU</th>
              <th>Current Quantity</th>
              <th>Status</th>
            </tr>
          </thead>

          <tbody>

            <% if (products.length === 0) { %>
              <tr>
                <td colspan="4" class="empty-message">
                  No products found.
                </td>
              </tr>
            <% } %>

            <% products.forEach((product) => { %>
              <tr>

                <td>
                  <%= product.name || product.productName || "Unnamed Product" %>
                </td>

                <td>
                  <%= product.sku || "-" %>
                </td>

                <td>
                  <%= product.quantity ?? 0 %>
                </td>

                <td>
                  <% if (Number(product.quantity || 0) === 0) { %>

                    <span class="stock-empty">Out of Stock</span>

                  <% } else if (
                    Number(product.quantity) <= Number(product.lowStockThreshold ?? 5)
                  ) { %>

                    <span class="stock-warning">Low Stock</span>

                  <% } else { %>

                    In Stock

                  <% } %>
                </td>

              </tr>
            <% }); %>

          </tbody>
        </table>
      </div>

      <p>
        Low-stock products:
        <strong><%= lowStockProducts.length %></strong>

        &nbsp; | &nbsp;

        Out-of-stock products:
        <strong><%= outOfStockProducts.length %></strong>
      </p>

    </section>

    <!-- Sales Table -->
    <section class="report-section">

      <h2>Recent Sales in Selected Period</h2>

      <div class="report-table-wrapper">
        <table class="report-table">

          <thead>
            <tr>
              <th>Sale ID</th>
              <th>Date</th>
              <th>Units</th>
              <th>Total Amount</th>
            </tr>
          </thead>

          <tbody>

            <% if (sales.length === 0) { %>
              <tr>
                <td colspan="4" class="empty-message">
                  No sales found for this date range.
                </td>
              </tr>
            <% } %>

            <% sales.forEach((sale) => { %>
              <tr>

                <td>
                  <%= String(sale._id).slice(-8) %>
                </td>

                <td>
                  <%= new Date(sale.saleDate).toLocaleDateString("en-IN") %>
                </td>

                <td>
                  <%= sale.items.reduce((sum, item) =>
                    sum + Number(item.quantity || 0), 0
                  ) %>
                </td>

                <td>
                  ₹<%= Number(sale.totalAmount || 0).toLocaleString("en-IN", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                  }) %>
                </td>

              </tr>
            <% }); %>

          </tbody>
        </table>
      </div>

    </section>

    <!-- Purchase Table -->
    <section class="report-section">

      <h2>Purchases in Selected Period</h2>

      <div class="report-table-wrapper">
        <table class="report-table">

          <thead>
            <tr>
              <th>Purchase ID</th>
              <th>Date</th>
              <th>Items</th>
              <th>Calculated Cost</th>
            </tr>
          </thead>

          <tbody>

            <% if (purchases.length === 0) { %>
              <tr>
                <td colspan="4" class="empty-message">
                  No purchases found for this date range.
                </td>
              </tr>
            <% } %>

            <% purchases.forEach((purchase) => { %>

              <% const purchaseCost = purchase.items.reduce(
                (sum, item) =>
                  sum +
                  Number(item.quantity || 0) *
                  Number(item.purchasePrice || 0),
                0
              ); %>

              <tr>

                <td>
                  <%= String(purchase._id).slice(-8) %>
                </td>

                <td>
                  <%= new Date(purchase.createdAt).toLocaleDateString("en-IN") %>
                </td>

                <td>
                  <%= purchase.items.length %>
                </td>

                <td>
                  ₹<%= purchaseCost.toLocaleString("en-IN", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                  }) %>
                </td>

              </tr>

            <% }); %>

          </tbody>
        </table>
      </div>

    </section>

  </main>

  <!-- Safely pass chart data from EJS to JavaScript -->
  <script id="daily-trends-data" type="application/json"><%- JSON.stringify(dailyTrends).replace(/</g, "\\u003c") %></script>

  <script>
    document.addEventListener("DOMContentLoaded", function () {

      // Read chart data
      const dataElement = document.getElementById("daily-trends-data");
      const dailyTrends = JSON.parse(dataElement.textContent);

      // Check Chart.js
      if (typeof Chart === "undefined") {
        console.error("Chart.js could not be loaded.");
        return;
      }

      // Format dates for charts
      const chartLabels = dailyTrends.labels.map(date => {
        const parts = date.split("-");
        return `${parts[2]}/${parts[1]}`;
      });

      // Currency formatting
      const formatCurrency = (value) => {
        return "₹" + Number(value).toLocaleString("en-IN", {
          maximumFractionDigits: 2
        });
      };

      // Common chart options
      const commonOptions = {
        responsive: true,
        maintainAspectRatio: false,

        interaction: {
          intersect: false,
          mode: "index"
        },

        plugins: {
          legend: {
            display: false
          },

          tooltip: {
            callbacks: {
              label: function (context) {
                return context.dataset.label + ": " +
                  formatCurrency(context.raw);
              }
            }
          }
        },

        scales: {
          y: {
            beginAtZero: true,

            ticks: {
              callback: function (value) {
                return formatCurrency(value);
              }
            }
          }
        }
      };

      // Helper: safely create a chart only once per canvas
      function createChart(canvasId, config) {
        const canvas = document.getElementById(canvasId);

        if (!canvas) {
          console.error("Canvas not found:", canvasId);
          return;
        }

        // Destroy an existing chart before creating another one
        const existingChart = Chart.getChart(canvas);

        if (existingChart) {
          existingChart.destroy();
        }

        return new Chart(canvas, config);
      }

      // 1. Daily Sales Revenue Chart
      createChart("salesChart", {

        type: "line",

        data: {
          labels: chartLabels,

          datasets: [{
            label: "Sales Revenue",
            data: dailyTrends.salesRevenue,

            borderColor: "#2563eb",
            backgroundColor: "rgba(37, 99, 235, 0.12)",

            borderWidth: 2,
            fill: true,
            tension: 0.3,
            pointRadius: 3
          }]
        },

        options: commonOptions

      });

      // 2. Daily Purchase Expenditure Chart
      createChart("purchaseChart", {

        type: "line",

        data: {
          labels: chartLabels,

          datasets: [{
            label: "Purchase Expenditure",
            data: dailyTrends.purchaseCost,

            borderColor: "#16a34a",
            backgroundColor: "rgba(22, 163, 74, 0.12)",

            borderWidth: 2,
            fill: true,
            tension: 0.3,
            pointRadius: 3
          }]
        },

        options: commonOptions

      });

      // 3. Sales vs Purchase Comparison Chart
      createChart("comparisonChart", {

        type: "bar",

        data: {
          labels: chartLabels,

          datasets: [
            {
              label: "Sales Revenue",
              data: dailyTrends.salesRevenue,
              backgroundColor: "#2563eb",
              borderRadius: 5
            },
            {
              label: "Purchase Expenditure",
              data: dailyTrends.purchaseCost,
              backgroundColor: "#16a34a",
              borderRadius: 5
            }
          ]
        },

        options: {
          responsive: true,
          maintainAspectRatio: false,

          plugins: {
            tooltip: {
              callbacks: {
                label: function (context) {
                  return context.dataset.label + ": " +
                    formatCurrency(context.raw);
                }
              }
            }
          },

          scales: {
            y: {
              beginAtZero: true,

              ticks: {
                callback: function (value) {
                  return formatCurrency(value);
                }
              }
            }
          }
        }

      });

      // 4. Quick Date Filters
      const startInput = document.getElementById("startDate");
      const endInput = document.getElementById("endDate");
      const filterForm = document.getElementById("filterForm");

      function formatInputDate(date) {
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, "0");
        const day = String(date.getDate()).padStart(2, "0");

        return `${year}-${month}-${day}`;
      }

      document.querySelectorAll(".quick-filter").forEach(button => {

        button.addEventListener("click", () => {

          const days = Number(button.dataset.days);

          const today = new Date();
          const start = new Date(today);

          if (days === 0) {
            start.setHours(0, 0, 0, 0);
          } else {
            start.setDate(start.getDate() - (days - 1));
            start.setHours(0, 0, 0, 0);
          }

          startInput.value = formatInputDate(start);
          endInput.value = formatInputDate(today);

          filterForm.requestSubmit();

        });

      });

      // 5. Add selected date range to export links
      const exportLinks = document.querySelectorAll(".export-link");

      exportLinks.forEach(link => {

        const base = link.dataset.base;
        const format = link.dataset.format;

        const params = new URLSearchParams();

        params.set("format", format);

        // Sales and purchases use the selected date range
        if (
          base === "/exports/sales" ||
          base === "/exports/purchases"
        ) {
          params.set("startDate", startInput.value);
          params.set("endDate", endInput.value);
        }

        // Inventory export shows current stock
        link.href = `${base}?${params.toString()}`;

      });

    });
  </script>

</body>
</html>
