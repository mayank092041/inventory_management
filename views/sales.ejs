<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sales History | InventoryPro</title>
    <link rel="stylesheet" href="/css/style.css">

    <style>
        .sales-container {
            max-width: 1250px;
            margin: 30px auto;
            padding: 24px;
        }

        .sales-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
            margin-bottom: 24px;
        }

        .sales-header h1 {
            margin: 0 0 6px;
        }

        .sales-muted {
            color: #64748b;
            font-size: 14px;
        }

        .sales-stats {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }

        .sales-stat {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 20px;
        }

        .sales-stat-label {
            color: #64748b;
            font-size: 14px;
            margin-bottom: 8px;
        }

        .sales-stat-value {
            font-size: 25px;
            font-weight: 800;
            color: #0f172a;
            overflow-wrap: anywhere;
        }

        .sales-card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            padding: 22px;
            box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
        }

        .sales-card h2 {
            margin-top: 0;
            font-size: 18px;
        }

        .sales-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 18px;
        }

        .sales-search {
            width: 100%;
            max-width: 340px;
            box-sizing: border-box;
            padding: 11px 12px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            font: inherit;
        }

        .sales-table-wrap {
            width: 100%;
            overflow-x: auto;
        }

        .sales-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 850px;
        }

        .sales-table th,
        .sales-table td {
            padding: 14px 12px;
            text-align: left;
            border-bottom: 1px solid #e2e8f0;
            vertical-align: top;
        }

        .sales-table th {
            background: #f8fafc;
            color: #475569;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .sales-table td {
            font-size: 14px;
            color: #334155;
        }

        .sales-table tbody tr:hover {
            background: #f8fafc;
        }

        .sales-id {
            font-weight: 700;
            color: #1d4ed8;
        }

        .sales-amount {
            font-weight: 800;
            color: #0f766e !important;
            white-space: nowrap;
        }

        .sales-product-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
            min-width: 180px;
        }

        .sales-product {
            padding-bottom: 7px;
            border-bottom: 1px dashed #e2e8f0;
        }

        .sales-product:last-child {
            border-bottom: 0;
            padding-bottom: 0;
        }

        .sales-product-name {
            font-weight: 600;
            color: #0f172a;
        }

        .sales-product-detail {
            font-size: 12px;
            color: #64748b;
            margin-top: 3px;
        }

        .sales-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 11px 16px;
            border: 0;
            border-radius: 8px;
            cursor: pointer;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
        }

        .sales-primary {
            background: #2563eb;
            color: #fff;
        }

        .sales-secondary {
            background: #e2e8f0;
            color: #1e293b;
        }

        .sales-empty {
            text-align: center;
            padding: 45px 20px;
        }

        .sales-empty h3 {
            margin-bottom: 8px;
        }

        .sales-empty p {
            color: #64748b;
        }

        .sales-empty a {
            margin-top: 12px;
        }

        .sales-hidden {
            display: none;
        }

        @media (max-width: 720px) {
            .sales-container {
                padding: 14px;
                margin: 12px auto;
            }

            .sales-stats {
                grid-template-columns: 1fr;
            }

            .sales-card {
                padding: 14px;
            }

            .sales-toolbar {
                align-items: stretch;
                flex-direction: column;
            }

            .sales-search {
                max-width: none;
            }
        }
    </style>
</head>

<body>
    <main class="sales-container">
        <header class="sales-header">
            <div>
                <h1>Sales History</h1>
                <p class="sales-muted">Review completed sales and the products sold.</p>
            </div>

            <div style="display:flex; gap:10px; flex-wrap:wrap;">
                <% if (user && ["Admin", "Manager" ].includes(user.role)) { %>
                    <a href="/sales/add" class="sales-button sales-primary">+ Record Sale</a>
                    <% } %>
                        <a href="/dashboard" class="sales-button sales-secondary">Dashboard</a>
            </div>
        </header>

        <section class="sales-stats">
            <div class="sales-stat">
                <div class="sales-stat-label">Total Sales</div>
                <div class="sales-stat-value">
                    <%= sales.length %>
                </div>
            </div>

            <div class="sales-stat">
                <div class="sales-stat-label">Total Sales Revenue</div>
                <div class="sales-stat-value">
                    ₹<%= sales.reduce((sum, sale)=> sum + (Number(sale.totalAmount) || 0), 0).toLocaleString("en-IN", {
                        minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                </div>
            </div>

            <div class="sales-stat">
                <div class="sales-stat-label">Products Sold (Units)</div>
                <div class="sales-stat-value">
                    <%= sales.reduce((sum, sale)=> sum + (sale.items || []).reduce((itemSum, item) => itemSum +
                        (Number(item.quantity) || 0), 0), 0) %>
                </div>
            </div>
        </section>

        <section class="sales-card">
            <div class="sales-toolbar">
                <div>
                    <h2>All Transactions</h2>
                    <p class="sales-muted">Newest sales appear first.</p>
                </div>

                <% if (sales.length> 0) { %>
                    <input type="search" id="salesSearch" class="sales-search"
                        placeholder="Search sale ID, product, or employee..." aria-label="Search sales">
                    <% } %>
            </div>

            <% if (!sales || sales.length===0) { %>
                <div class="sales-empty">
                    <h3>No sales recorded yet</h3>
                    <p>Once you record a sale, it will appear here.</p>
                    <% if (user && ["Admin", "Manager" ].includes(user.role)) { %>
                        <a href="/sales/add" class="sales-button sales-primary">Record Your First Sale</a>
                        <% } %>
                </div>
                <% } else { %>
                    <div class="sales-table-wrap">
                        <table class="sales-table">
                            <thead>
                                <tr>
                                    <th>Sale ID</th>
                                    <th>Date</th>
                                    <th>Products Sold</th>
                                    <th>Total Amount</th>
                                    <th>Recorded By</th>
                                </tr>
                            </thead>

                            <tbody id="salesTableBody">
                                <% sales.forEach(sale=> { %>
                                    <tr class="sale-row">
                                        <td>
                                            <span class="sales-id">
                                                #<%= String(sale._id).slice(-8).toUpperCase() %>
                                            </span>
                                        </td>

                                        <td>
                                            <%= new Date(sale.saleDate || sale.createdAt).toLocaleString("en-IN", {
                                                day: "2-digit" , month: "short" , year: "numeric" , hour: "2-digit" ,
                                                minute: "2-digit" }) %>
                                        </td>

                                        <td>
                                            <div class="sales-product-list">
                                                <% (sale.items || []).forEach(item=> { %>
                                                    <div class="sales-product">
                                                        <div class="sales-product-name">
                                                            <%= item.product ? (item.product.name ||
                                                                item.product.productName || item.product.title
                                                                || "Unnamed Product" ) : "Product no longer available"
                                                                %>
                                                        </div>
                                                        <div class="sales-product-detail">
                                                            Qty: <%= item.quantity %> × ₹<%= Number(item.sellingPrice ||
                                                                    0).toLocaleString("en-IN", { minimumFractionDigits:
                                                                    2, maximumFractionDigits: 2 }) %>
                                                        </div>
                                                    </div>
                                                    <% }) %>
                                            </div>
                                        </td>

                                        <td class="sales-amount">
                                            ₹<%= Number(sale.totalAmount || 0).toLocaleString("en-IN", {
                                                minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                        </td>

                                        <td>
                                            <%= sale.soldBy ? (sale.soldBy.name || sale.soldBy.userId ||
                                                sale.soldBy.email || "User" ) : "Unknown User" %>
                                        </td>
                                    </tr>
                                    <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <p id="noSearchResults" class="sales-muted sales-hidden" style="text-align:center; padding:20px;">
                        No sales match your search.
                    </p>
                    <% } %>
        </section>
    </main>

    <script>
        const salesSearch = document.getElementById("salesSearch");
        const saleRows = document.querySelectorAll(".sale-row");
        const noSearchResults = document.getElementById("noSearchResults");

        if (salesSearch) {
            salesSearch.addEventListener("input", () => {
                const searchTerm = salesSearch.value.toLowerCase().trim();
                let visibleCount = 0;

                saleRows.forEach(row => {
                    const matches = row.textContent.toLowerCase().includes(searchTerm);
                    row.classList.toggle("sales-hidden", !matches);

                    if (matches) visibleCount++;
                });

                if (noSearchResults) {
                    noSearchResults.classList.toggle("sales-hidden", visibleCount !== 0);
                }
            });
        }
    </script>
</body>

</html>