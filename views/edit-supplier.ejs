
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Supplier - InventoryPro</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="dashboard-page">

    <div class="container">
        <div class="category-form-card supplier-form-card">

            <div class="category-card-header">
                <div>
                    <h1>Edit Supplier</h1>
                    <p>Update the supplier's contact and company details.</p>
                </div>

                <a href="/suppliers" class="secondary-button">
                    Back to Suppliers
                </a>
            </div>

            <form action="/suppliers/edit/<%= supplier._id %>" method="POST">

                <div class="form-group">
                    <label for="name">Contact Person Name *</label>
                    <input
                        type="text"
                        id="name"
                        name="name"
                        value="<%= supplier.name %>"
                        placeholder="Enter contact person's name"
                        required
                        maxlength="100"
                    >
                </div>

                <div class="form-group">
                    <label for="company">Company Name</label>
                    <input
                        type="text"
                        id="company"
                        name="company"
                        value="<%= supplier.company || '' %>"
                        placeholder="Enter company name"
                        maxlength="150"
                    >
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="email">Email Address</label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            value="<%= supplier.email || '' %>"
                            placeholder="supplier@example.com"
                            maxlength="254"
                        >
                    </div>

                    <div class="form-group">
                        <label for="phone">Phone Number *</label>
                        <input
                            type="tel"
                            id="phone"
                            name="phone"
                            value="<%= supplier.phone %>"
                            placeholder="Enter contact number"
                            required
                            maxlength="20"
                        >
                    </div>
                </div>

                <div class="form-group">
                    <label for="address">Business Address</label>
                    <textarea
                        id="address"
                        name="address"
                        rows="4"
                        placeholder="Enter supplier's business address"
                        maxlength="500"
                    ><%= supplier.address || '' %></textarea>
                </div>

                <div class="form-actions">
                    <button type="submit" class="primary-button">
                        Update Supplier
                    </button>

                    <a href="/suppliers" class="secondary-button">
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>

</body>
</html>